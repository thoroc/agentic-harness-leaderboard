---
import { readFileSync, existsSync } from "node:fs";
import BaseLayout from "../layouts/BaseLayout.astro";
import StatsGrid from "../components/StatsGrid.astro";
import TrendChart from "../components/TrendChart.astro";
import KindShare from "../components/KindShare.astro";
import GrowthList from "../components/GrowthList.astro";
import LeaderboardTable from "../components/LeaderboardTable.astro";
import type { SitePayload, HistoryPayload } from "../data/types";

export function getStaticPaths() {
  const locales = ["en", "zh", "fr", "de", "it", "es", "pt", "pl", "ru", "ko", "ja"];
  return [
    { params: { slug: undefined } },
    ...locales.filter((l) => l !== "en").map((lang) => ({
      params: { slug: lang },
    })),
  ];
}

const { slug } = Astro.params;
const lang = typeof slug === "string" ? slug : "en";
const SUPPORTED_LOCALES = ["en", "zh", "fr", "de", "it", "es", "pt", "pl", "ru", "ko", "ja"];

let latest: SitePayload = {
  generatedAt: new Date().toISOString(),
  generatedDate: "",
  generatedDateTime: "",
  timezone: "UTC",
  totals: { agents: 0, repos: 0, stars: 0, forks: 0, openAgents: 0, closedAgents: 0, unknownAgents: 0 },
  agents: [],
  translations: {},
} as SitePayload;
let history: HistoryPayload = { updatedAt: "", snapshots: [] };

try {
  const latestPath = "public/data/latest.json";
  const historyPath = "public/data/history.json";
  if (existsSync(latestPath)) {
    latest = JSON.parse(readFileSync(latestPath, "utf-8"));
  }
  if (existsSync(historyPath)) {
    history = JSON.parse(readFileSync(historyPath, "utf-8"));
  }
} catch {}

const translations: Record<string, string> = latest.translations?.[lang] ?? latest.translations?.en ?? {};
---

<BaseLayout lang={lang} translations={translations}>
  <StatsGrid payload={latest} history={history} translations={translations} lang={lang} />
  <TrendChart payload={latest} history={history} translations={translations} lang={lang} />
  <div class="split">
    <KindShare payload={latest} translations={translations} lang={lang} />
    <GrowthList payload={latest} history={history} translations={translations} lang={lang} />
  </div>
  <LeaderboardTable payload={latest} history={history} translations={translations} lang={lang} />
</BaseLayout>
